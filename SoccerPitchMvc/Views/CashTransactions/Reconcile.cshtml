@{
    ViewData["Title"] = "Đối Soát Thu Chi";
    int m = (int)ViewBag.Month;
    int y = (int)ViewBag.Year;
    decimal bookingTotal = (decimal)ViewBag.BookingTotal;
    decimal cashTotal = (decimal)ViewBag.CashTotal;
    decimal difference = (decimal)ViewBag.Difference;
    bool balanced = Math.Abs(difference) < 1000;

    var bookings = ViewBag.Bookings as IEnumerable<SoccerPitchMvc.Models.Booking>;
}

<div class="container-fluid mt-2">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-scale-balanced text-warning"></i> Đối Soát Thu Chi
            </h2>
            <p class="text-muted mb-0">So sánh doanh thu đặt sân với sổ quỹ — Tháng @m/@y</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Income" class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-money-bill-wave me-1"></i> Phiếu Thu
            </a>
        </div>
    </div>

    @* Filter tháng *@
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-auto">
                    <select name="month" class="form-select" style="width:120px;">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == m)">Tháng @i</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <select name="year" class="form-select" style="width:110px;">
                        @for (int i = DateTime.Today.Year - 2; i <= DateTime.Today.Year + 1; i++)
                        {
                            <option value="@i" selected="@(i == y)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> Xem</button>
                </div>
            </form>
        </div>
    </div>

    @* Kết quả đối soát *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-calendar-check text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đặt sân đã thanh toán</div>
                        <div class="fw-bold fs-5 text-primary">@bookingTotal.ToString("#,##0") VNĐ</div>
                        <div class="text-muted small">@(bookings?.Count() ?? 0) lượt</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-book-open text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Thu ghi sổ quỹ</div>
                        <div class="fw-bold fs-5 text-success">@cashTotal.ToString("#,##0") VNĐ</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 @(balanced ? "border-success" : "border-warning") border-2">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="@(balanced ? "bg-success" : "bg-warning") bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-scale-balanced @(balanced ? "text-success" : "text-warning") fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Chênh lệch</div>
                        <div class="fw-bold fs-5 @(balanced ? "text-success" : "text-warning")">
                            @(difference >= 0 ? "+" : "")@difference.ToString("#,##0") VNĐ
                        </div>
                        <div class="small @(balanced ? "text-success" : "text-warning") fw-semibold">
                            @(balanced ? "✓ Cân bằng" : "⚠ Có chênh lệch")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Bảng chi tiết booking *@
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 fw-bold py-3">
            <i class="fa-solid fa-list-check me-2 text-primary"></i> Chi Tiết Đặt Sân Đã Thanh Toán — Tháng @m/@y
        </div>
        @if (bookings == null || !bookings.Any())
        {
            <div class="card-body text-center py-4">
                <p class="text-muted">Không có đặt sân nào đã thanh toán trong tháng này.</p>
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th class="py-3 px-4">#</th>
                                <th class="py-3">Khách Hàng</th>
                                <th class="py-3">Sân</th>
                                <th class="py-3">Ngày</th>
                                <th class="py-3">Khung Giờ</th>
                                <th class="py-3 text-end px-4">Tiền Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var b in bookings)
                            {
                                <tr>
                                    <td class="px-4 text-muted">@idx</td>
                                    <td class="fw-semibold">@b.Customer.FullName</td>
                                    <td><span class="badge bg-secondary">@b.Pitch.Name</span></td>
                                    <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-primary fw-semibold">
                                        @b.TimeSlot.StartTime.ToString("HH:mm") – @b.TimeSlot.EndTime.ToString("HH:mm")
                                    </td>
                                    <td class="text-end px-4 fw-bold text-success">@b.TotalPrice.ToString("#,##0") VNĐ</td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5" class="py-3 px-4">Tổng cộng (@(bookings.Count()) lượt)</td>
                                <td class="text-end px-4 text-primary fs-5">@bookingTotal.ToString("#,##0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@{
    ViewData["Title"] = "Báo Cáo Thu Chi";
    int y = (int)ViewBag.Year;
    decimal grandIncome = (decimal)ViewBag.GrandIncome;
    decimal grandExpense = (decimal)ViewBag.GrandExpense;
    decimal grandBooking = (decimal)ViewBag.GrandBooking;
    decimal netProfit = grandIncome - grandExpense;

    var monthlyData = ViewBag.MonthlyData as IEnumerable<dynamic>;
}

<div class="container-fluid mt-2">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-chart-pie text-info"></i> Báo Cáo Thu Chi Năm @y
            </h2>
            <p class="text-muted mb-0">Tổng hợp thu – chi – lợi nhuận từng tháng</p>
        </div>
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="year" class="form-select" style="width:110px;">
                @for (int i = DateTime.Today.Year - 2; i <= DateTime.Today.Year + 1; i++)
                {
                    <option value="@i" selected="@(i == y)">@i</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Xem</button>
        </form>
    </div>

    @* Tổng kết năm *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-arrow-trend-up text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng Thu (Sổ Quỹ)</div>
                        <div class="fw-bold fs-5 text-success">@grandIncome.ToString("#,##0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-arrow-trend-down text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng Chi (Sổ Quỹ)</div>
                        <div class="fw-bold fs-5 text-danger">@grandExpense.ToString("#,##0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-calendar-check text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Doanh Thu Đặt Sân</div>
                        <div class="fw-bold fs-5 text-primary">@grandBooking.ToString("#,##0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="@(netProfit >= 0 ? "bg-success" : "bg-danger") bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-wallet @(netProfit >= 0 ? "text-success" : "text-danger") fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Lợi Nhuận Ròng</div>
                        <div class="fw-bold fs-5 @(netProfit >= 0 ? "text-success" : "text-danger")">
                            @(netProfit >= 0 ? "+" : "")@netProfit.ToString("#,##0")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Bảng theo tháng *@
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 fw-bold py-3">
            <i class="fa-solid fa-table me-2 text-info"></i> Chi Tiết Từng Tháng — Năm @y
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 px-4">Tháng</th>
                            <th class="py-3 text-end">Thu (Sổ Quỹ)</th>
                            <th class="py-3 text-end">Chi (Vận Hành)</th>
                            <th class="py-3 text-end">Doanh Thu Đặt Sân</th>
                            <th class="py-3 text-end">Lợi Nhuận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (monthlyData != null)
                        {
                            @foreach (var row in monthlyData)
                            {
                                decimal income = (decimal)row.TotalIncome;
                                decimal expense = (decimal)row.TotalExpense;
                                decimal booking = (decimal)row.BookingRevenue;
                                decimal profit = income - expense;
                                bool hasData = income > 0 || expense > 0 || booking > 0;

                                <tr class="@(!hasData ? "text-muted" : "")">
                                    <td class="px-4 fw-semibold">Tháng @row.Month</td>
                                    <td class="text-end @(income > 0 ? "text-success fw-semibold" : "text-muted")">
                                        @(income > 0 ? income.ToString("#,##0") + " VNĐ" : "—")
                                    </td>
                                    <td class="text-end @(expense > 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(expense > 0 ? expense.ToString("#,##0") + " VNĐ" : "—")
                                    </td>
                                    <td class="text-end @(booking > 0 ? "text-primary fw-semibold" : "text-muted")">
                                        @(booking > 0 ? booking.ToString("#,##0") + " VNĐ" : "—")
                                    </td>
                                    <td class="text-end fw-bold @(profit > 0 ? "text-success" : profit < 0 ? "text-danger" : "text-muted")">
                                        @(hasData ? (profit >= 0 ? "+" : "") + profit.ToString("#,##0") + " VNĐ" : "—")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td class="py-3 px-4">Tổng cả năm</td>
                            <td class="text-end text-success">@grandIncome.ToString("#,##0") VNĐ</td>
                            <td class="text-end text-danger">@grandExpense.ToString("#,##0") VNĐ</td>
                            <td class="text-end text-primary">@grandBooking.ToString("#,##0") VNĐ</td>
                            <td class="text-end @(netProfit >= 0 ? "text-success" : "text-danger")">
                                @(netProfit >= 0 ? "+" : "")@netProfit.ToString("#,##0") VNĐ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

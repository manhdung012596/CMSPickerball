@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5" style="background: #ffffff; border: 1px solid var(--border-color) !important;">
                <div class="mb-4">
                    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 80px;"></i>
                </div>
                <h1 class="fw-extrabold text-slate-800 mb-3" style="font-family: 'Outfit', sans-serif; font-size: 32px;">Từ Chối Truy Cập</h1>
                <p class="text-muted fs-5 mb-4">Bạn không có quyền truy cập vào trang này. Trang web chỉ dành riêng cho Quản trị viên hệ thống.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Home" class="btn-primary-custom px-4 py-2">Quay lại Trang chủ</a>
                    <a href="/Account/Login" class="btn btn-outline-secondary rounded-3 px-4 py-2" style="font-weight:600;">Đăng nhập tài khoản khác</a>
                </div>
            </div>
        </div>
    </div>
</div>

@model SoccerPitchMvc.Models.RegisterViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Đăng ký tài khoản";
}

@section Styles {
<style>
    .auth-section {
        padding: 80px 0;
        background-color: var(--light-bg);
    }
    .auth-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid var(--border-color);
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        max-width: 500px;
        margin: 0 auto;
        transition: var(--transition-smooth);
    }
    .auth-header {
        background-color: var(--dark-slate);
        color: #ffffff;
        padding: 30px;
        text-align: center;
        border-bottom: 3px solid var(--lime-green);
    }
    .auth-title {
        font-size: 26px;
        font-weight: 800;
        font-family: 'Outfit', sans-serif;
        margin-bottom: 5px;
    }
    .auth-subtitle {
        color: #94a3b8;
        font-size: 14px;
    }
    .auth-body {
        padding: 40px 30px;
    }
    .form-group-custom {
        margin-bottom: 20px;
    }
    .form-label-custom {
        font-size: 13px;
        font-weight: 600;
        color: var(--dark-slate);
        margin-bottom: 6px;
        display: block;
    }
    .form-control-custom {
        background-color: #f8fafc;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        color: var(--dark-slate);
        font-size: 14px;
        padding: 12px 16px;
        font-weight: 500;
        transition: var(--transition-smooth);
    }
    .form-control-custom:focus {
        background-color: #ffffff;
        border-color: var(--lime-green);
        box-shadow: 0 0 0 4px rgba(132, 204, 22, 0.15);
        outline: none;
    }
    .btn-auth-submit {
        background: linear-gradient(135deg, var(--lime-green) 0%, #76b813 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 16px;
        width: 100%;
        border: none;
        padding: 14px 0;
        border-radius: 12px;
        margin-top: 10px;
        box-shadow: 0 4px 15px rgba(132, 204, 22, 0.2);
        transition: var(--transition-smooth);
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
    }
    .btn-auth-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(132, 204, 22, 0.3);
        background: var(--dark-slate);
    }
    .auth-footer-link {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #64748b;
    }
    .auth-footer-link a {
        color: var(--lime-green);
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition-smooth);
    }
    .auth-footer-link a:hover {
        color: var(--dark-slate);
        text-decoration: underline;
    }
    .field-validation-error {
        color: #ef4444;
        font-size: 12px;
        margin-top: 5px;
        display: block;
        font-weight: 500;
    }
    .validation-summary-errors {
        background-color: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 25px;
        color: #b91c1c;
        font-size: 13px;
    }
    .validation-summary-errors ul {
        margin: 0;
        padding-left: 20px;
    }
</style>
}

<div class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Đăng Ký Thành Viên</h1>
                <p class="auth-subtitle">Trở thành thành viên Elite Pickleball ngay hôm nay</p>
            </div>
            <div class="auth-body">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group-custom">
                        <label asp-for="FullName" class="form-label-custom">Họ và tên *</label>
                        <input asp-for="FullName" class="form-control form-control-custom w-100" placeholder="Nhập họ và tên đầy đủ..." />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Email" class="form-label-custom">Địa chỉ Email *</label>
                        <input asp-for="Email" type="email" class="form-control form-control-custom w-100" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="PhoneNumber" class="form-label-custom">Số điện thoại *</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control form-control-custom w-100" placeholder="Nhập số điện thoại (10 số)..." />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Password" class="form-label-custom">Mật khẩu *</label>
                        <input asp-for="Password" type="password" class="form-control form-control-custom w-100" placeholder="Tối thiểu 6 ký tự..." />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="ConfirmPassword" class="form-label-custom">Xác nhận mật khẩu *</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-custom w-100" placeholder="Nhập lại mật khẩu..." />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-auth-submit">
                        <i class="fa-solid fa-user-plus me-2"></i>Đăng Ký Tài Khoản
                    </button>
                </form>

                <div class="auth-footer-link">
                    Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

@model SoccerPitchMvc.Models.LoginViewModel
@{
    Layout = null; // We use a custom, clean layout for the admin login screen to make it feel separate and premium
    ViewData["Title"] = "Đăng nhập hệ thống - Admin & Staff";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #10b981;
            --primary-hover: #059669;
            --bg-dark: #0b1329;
            --card-bg: #131f37;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --border-color: #223254;
            --input-bg: #0b1329;
            --brand-green: #22c55e;
        }

        body, input, button, select, textarea, label, h1, h2, h3, h4, h5, h6, p, a, span:not([class*="fa-"]), div {
            font-family: 'Times New Roman', Times, serif;
        }

        /* Bảo đảm không ghi đè font của icon FontAwesome */
        i, .fa, .fas, .far, .fab, .fa-solid, .fa-regular, [class*="fa-"] {
            font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands" !important;
            font-style: normal;
            font-variant: normal;
            text-rendering: auto;
            line-height: 1;
        }
        .fa-solid, .fas {
            font-weight: 900 !important;
        }
        .fa-regular, .far {
            font-weight: 400 !important;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
            position: relative;
        }

        /* Abstract decorative background blobs */
        body::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, rgba(0,0,0,0) 70%);
            top: -100px;
            left: -100px;
            z-index: 0;
        }
        body::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(34, 197, 94, 0.1) 0%, rgba(0,0,0,0) 70%);
            bottom: -150px;
            right: -150px;
            z-index: 0;
        }

        .login-container {
            z-index: 10;
            width: 100%;
            max-width: 460px;
            padding: 20px;
        }

        .login-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            padding: 38px 32px;
            transition: all 0.3s ease;
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo-icon-box {
            width: 80px;
            height: 80px;
            background: #081021;
            border: 2px solid #1e293b;
            border-radius: 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            box-shadow: 0 10px 25px -5px rgba(34, 197, 94, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .logo-icon-box:hover {
            transform: scale(1.06);
            box-shadow: 0 12px 30px -5px rgba(34, 197, 94, 0.45);
        }

        .logo-icon-box i {
            font-size: 40px;
            color: #22c55e;
        }

        .brand-title {
            font-size: 26px;
            font-weight: bold;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .brand-subtitle {
            color: var(--text-muted);
            font-size: 15px;
            font-style: italic;
        }

        .form-label-custom {
            font-size: 15px;
            font-weight: bold;
            color: var(--text-main);
            margin-bottom: 8px;
            display: block;
            letter-spacing: 0.3px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group-custom i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
            transition: color 0.3s ease;
        }

        .form-control-custom {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 16px;
            padding: 13px 16px 13px 46px;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--brand-green);
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
            background-color: var(--input-bg);
        }

        .form-control-custom:focus + i {
            color: var(--brand-green);
        }

        .form-check-custom {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            color: var(--text-muted);
            cursor: pointer;
            user-select: none;
        }

        .form-check-input-custom {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            background-color: var(--input-bg);
            accent-color: var(--brand-green);
            cursor: pointer;
        }

        .btn-login-submit {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #ffffff;
            font-weight: bold;
            font-size: 17px;
            width: 100%;
            border: none;
            padding: 13px 0;
            border-radius: 10px;
            margin-top: 15px;
            box-shadow: 0 10px 20px -10px rgba(16, 185, 129, 0.5);
            transition: all 0.3s ease;
            cursor: pointer;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-login-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -10px rgba(16, 185, 129, 0.6);
            background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
        }

        .btn-login-submit:active {
            transform: translateY(0);
        }

        .validation-summary-errors {
            background-color: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
            font-size: 15px;
            color: #fca5a5;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 15px;
            color: var(--text-muted);
        }

        .footer-text a {
            color: #34d399;
            text-decoration: none;
            font-weight: bold;
        }

        .footer-text a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-card">
            <div class="brand-logo">
                <div class="logo-icon-box">
                    <i class="fa-solid fa-table-tennis-paddle-ball"></i>
                </div>
                <h1 class="brand-title">HỆ THỐNG QUẢN TRỊ</h1>
                <p class="brand-subtitle">CMS Pickleball - Quản trị & Vận hành cơ sở</p>
            </div>

            <form asp-action="AdminLogin" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary-errors">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        @Html.ValidationSummary(true)
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="EmailOrPhone">Email tài khoản</label>
                    <div class="input-group-custom">
                        <input type="text" asp-for="EmailOrPhone" class="form-control-custom" placeholder="admin@elitepickleball.com" required autocomplete="username" />
                        <i class="fa-regular fa-envelope"></i>
                    </div>
                    <span asp-validation-for="EmailOrPhone" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom" asp-for="Password">Mật khẩu bảo mật</label>
                    <div class="input-group-custom">
                        <input type="password" asp-for="Password" class="form-control-custom" placeholder="••••••••" required autocomplete="current-password" />
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <label class="form-check-custom">
                        <input type="checkbox" asp-for="RememberMe" class="form-check-input-custom" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button type="submit" class="btn-login-submit">
                    ĐĂNG NHẬP HỆ THỐNG <i class="fa-solid fa-arrow-right-to-bracket ms-1"></i>
                </button>
            </form>
        </div>

        <div class="footer-text">
            <span>Bạn là khách hàng đặt sân? </span>
            <a href="/Account/Login">Đăng nhập khách hàng <i class="fa-solid fa-arrow-right small ms-1"></i></a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

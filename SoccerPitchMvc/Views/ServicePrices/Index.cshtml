@model IEnumerable<SoccerPitchMvc.Models.ServicePrice>

@{
    ViewData["Title"] = (string)ViewBag.CurrentTypeName;
    var serviceTypeNames = ViewBag.ServiceTypeNames as Dictionary<int, string>
        ?? new Dictionary<int, string>();
    int? currentType = ViewBag.ServiceType as int?;

    string badgeColor(int t) => t switch { 0 => "secondary", 1 => "primary", 2 => "info", 3 => "success", 4 => "warning", _ => "secondary" };
    string iconClass(int t) => t switch { 0 => "fa-table-tennis-paddle-ball", 1 => "fa-table-tennis-paddle-ball", 2 => "fa-circle", 3 => "fa-graduation-cap", 4 => "fa-trophy", _ => "fa-bell-concierge" };
}

<div class="container-fluid mt-2">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-bell-concierge text-primary"></i>
                @ViewBag.CurrentTypeName
            </h2>
            <p class="text-muted mb-0">Quản lý danh sách và bảng giá dịch vụ</p>
        </div>
        <a asp-action="Create" asp-route-serviceType="@currentType" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm Dịch Vụ
        </a>
    </div>

    @* Tab filter theo loại *@
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <a asp-action="Index" class="btn btn-sm @(currentType == null ? "btn-dark" : "btn-outline-secondary")">
                    Tất cả
                </a>
                @foreach (var kv in serviceTypeNames)
                {
                    <a asp-action="Index" asp-route-serviceType="@kv.Key"
                       class="btn btn-sm @(currentType == kv.Key ? "btn-" + badgeColor(kv.Key) : "btn-outline-" + badgeColor(kv.Key))">
                        <i class="fa-solid @iconClass(kv.Key) me-1"></i> @kv.Value
                    </a>
                }
            </div>
        </div>
    </div>

    @* Bảng dịch vụ *@
    <div class="card border-0 shadow-sm rounded-3">
        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-bell-concierge display-3 text-secondary mb-3 d-block"></i>
                <h5 class="text-muted">Chưa có dịch vụ nào</h5>
                <p class="text-muted small">Thêm dịch vụ mới để bắt đầu quản lý bảng giá.</p>
                <a asp-action="Create" asp-route-serviceType="@currentType" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Thêm Dịch Vụ
                </a>
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="py-3 px-4" style="width:50px;">#</th>
                                <th class="py-3">Tên Dịch Vụ</th>
                                <th class="py-3">Loại</th>
                                <th class="py-3">Mô Tả</th>
                                <th class="py-3 text-end">Đơn Giá</th>
                                <th class="py-3 text-center">Thứ Tự</th>
                                <th class="py-3 text-center">Trạng Thái</th>
                                <th class="py-3 text-end px-4">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var item in Model)
                            {
                                bool isActive = item.Status == 1;
                                string typeName = serviceTypeNames.ContainsKey(item.ServiceType) ? serviceTypeNames[item.ServiceType] : "Khác";

                                <tr class="@(!isActive ? "table-secondary text-muted" : "")">
                                    <td class="px-4 fw-semibold text-muted">@idx</td>
                                    <td>
                                        <div class="fw-bold @(!isActive ? "text-muted" : "text-dark")">@item.ServiceName</div>
                                        @if (!string.IsNullOrEmpty(item.Note))
                                        {
                                            <div class="small text-muted"><i class="bi bi-info-circle me-1"></i>@item.Note</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@badgeColor(item.ServiceType) px-3">@typeName</span>
                                    </td>
                                    <td class="small text-muted" style="max-width:200px;">
                                        @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                    </td>
                                    <td class="text-end fw-bold @(isActive ? "text-success" : "text-muted")">
                                        @item.Price.ToString("#,##0") VNĐ
                                        <div class="small fw-normal text-muted">/@(item.PriceUnit ?? "lần")</div>
                                    </td>
                                    <td class="text-center text-muted">@item.SortOrder</td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="serviceType" value="@item.ServiceType" />
                                            <button type="submit" class="btn btn-sm @(isActive ? "btn-success" : "btn-outline-secondary")" title="@(isActive ? "Đang hiển thị — nhấn để ẩn" : "Đang ẩn — nhấn để hiện")">
                                                @if (isActive)
                                                {
                                                    <i class="bi bi-eye-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-eye-slash"></i>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    data-bs-toggle="modal" data-bs-target="#del-@item.Id">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>

                                        @* Modal xóa *@
                                        <div class="modal fade" id="del-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Xác nhận xóa
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body py-4">
                                                        Bạn có chắc muốn xóa dịch vụ <strong class="text-danger">@item.ServiceName</strong>?
                                                    </div>
                                                    <div class="modal-footer bg-light border-0">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            <button type="submit" class="btn btn-danger px-4">
                                                                <i class="bi bi-trash-fill me-1"></i> Xóa
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light border-0 py-2 px-4 text-muted small">
                Tổng <strong>@Model.Count()</strong> dịch vụ
                — Đang hiển thị: <strong class="text-success">@Model.Count(s => s.Status == 1)</strong>
                — Ẩn: <strong class="text-secondary">@Model.Count(s => s.Status == 0)</strong>
            </div>
        }
    </div>
</div>

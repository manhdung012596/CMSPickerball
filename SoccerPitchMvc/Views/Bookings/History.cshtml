@model IEnumerable<SoccerPitchMvc.Models.Booking>

@{
    ViewData["Title"] = "Lịch Sử Đặt Sân";
    int totalPaid = (int)ViewBag.TotalPaid;
    int totalCancelled = (int)ViewBag.TotalCancelled;
    decimal totalRevenue = (decimal)ViewBag.TotalRevenue;
}

<div class="container-fluid mt-2">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-history text-info"></i> Lịch Sử Đặt Sân
            </h2>
            <p class="text-muted mb-0">Tra cứu lịch sử các lượt đặt sân đã hoàn tất hoặc đã hủy</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-list-check me-1"></i> Tất cả đặt sân
        </a>
    </div>

    @* Thống kê nhanh *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-cash-register text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đã thanh toán</div>
                        <div class="fw-bold fs-4 text-success">@totalPaid</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-ban text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đã hủy</div>
                        <div class="fw-bold fs-4 text-danger">@totalCancelled</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="fa-solid fa-wallet text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng doanh thu lọc được</div>
                        <div class="fw-bold fs-5 text-primary">@totalRevenue.ToString("#,##0") VNĐ</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Bộ lọc *@
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted mb-1">
                        <i class="fa-solid fa-search me-1"></i> Tìm kiếm
                    </label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Tên KH, SĐT, tên sân..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted mb-1">Từ ngày</label>
                    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted mb-1">Đến ngày</label>
                    <input type="date" name="to" value="@ViewBag.To" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted mb-1">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="2" selected="@(ViewBag.StatusFilter?.ToString() == "2")">Đã thanh toán</option>
                        <option value="3" selected="@(ViewBag.StatusFilter?.ToString() == "3")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Lọc
                    </button>
                    <a asp-action="History" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Xóa lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* Bảng lịch sử *@
    <div class="card border-0 shadow-sm rounded-3">
        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-box-open display-3 text-secondary mb-3 d-block"></i>
                <h5 class="text-muted">Không tìm thấy lịch sử đặt sân</h5>
                <p class="text-muted small">Thử thay đổi bộ lọc tìm kiếm.</p>
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="py-3 px-4">#</th>
                                <th class="py-3">Khách Hàng</th>
                                <th class="py-3">Sân</th>
                                <th class="py-3">Ngày Đặt</th>
                                <th class="py-3">Khung Giờ</th>
                                <th class="py-3">Tổng Tiền</th>
                                <th class="py-3">Ghi Chú</th>
                                <th class="py-3">Ngày Tạo</th>
                                <th class="py-3 text-center">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var item in Model)
                            {
                                bool isPaid = item.Status == 2;

                                <tr>
                                    <td class="px-4 text-muted fw-semibold">@idx</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Customer.FullName</div>
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-phone me-1"></i>@item.Customer.PhoneNumber
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary px-3 py-2">@item.Pitch.Name</span>
                                    </td>
                                    <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="fw-semibold text-primary">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            @item.TimeSlot.StartTime.ToString("HH:mm") – @item.TimeSlot.EndTime.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td class="fw-bold @(isPaid ? "text-success" : "text-muted text-decoration-line-through")">
                                        @item.TotalPrice.ToString("#,##0") VNĐ
                                    </td>
                                    <td class="small text-muted" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @(string.IsNullOrEmpty(item.Note) ? "—" : item.Note)
                                    </td>
                                    <td class="small text-muted">
                                        @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-center">
                                        @if (isPaid)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-cash-coin me-1"></i> Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i> Đã hủy
                                            </span>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Hiển thị <strong>@Model.Count()</strong> kết quả
                    (<span class="text-success fw-semibold">@totalPaid đã thanh toán</span>,
                    <span class="text-danger fw-semibold">@totalCancelled đã hủy</span>)
                </span>
                @if (totalRevenue > 0)
                {
                    <span class="text-success fw-bold">
                        <i class="fa-solid fa-wallet me-1"></i>
                        Tổng thu: @totalRevenue.ToString("#,##0") VNĐ
                    </span>
                }
            </div>
        }
    </div>
</div>

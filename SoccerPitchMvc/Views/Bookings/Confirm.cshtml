@model IEnumerable<SoccerPitchMvc.Models.Booking>

@{
    ViewData["Title"] = "Xác Nhận Đặt Sân";
    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container-fluid mt-2">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-circle-check text-warning"></i> Xác Nhận Đặt Sân
            </h2>
            <p class="text-muted mb-0">
                Các lượt đặt sân đang chờ xác nhận
                @if ((int)ViewBag.PendingCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-2 fs-6">@ViewBag.PendingCount chờ xác nhận</span>
                }
            </p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg"></i> Đặt Sân Mới
        </a>
    </div>

    @* Bộ lọc *@
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small text-muted mb-1">
                        <i class="fa-solid fa-search me-1"></i> Tìm kiếm
                    </label>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Tên khách hàng, SĐT, tên sân..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted mb-1">
                        <i class="fa-solid fa-calendar me-1"></i> Ngày đặt
                    </label>
                    <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Lọc
                    </button>
                    <a asp-action="Confirm" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Xóa lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* Danh sách chờ xác nhận *@
    <div class="card border-0 shadow-sm rounded-3">
        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-circle-check display-3 text-success mb-3 d-block"></i>
                <h5 class="text-success fw-bold">Không có lượt đặt sân nào đang chờ!</h5>
                <p class="text-muted">Tất cả lượt đặt sân đã được xử lý.</p>
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-warning">
                            <tr>
                                <th class="py-3 px-4">#</th>
                                <th class="py-3">Khách Hàng</th>
                                <th class="py-3">Sân</th>
                                <th class="py-3">Ngày Đặt</th>
                                <th class="py-3">Khung Giờ</th>
                                <th class="py-3">Tổng Tiền</th>
                                <th class="py-3">Ghi Chú</th>
                                <th class="py-3 text-end px-4">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int idx = 1;}
                            @foreach (var item in Model)
                            {
                                bool isToday = item.BookingDate == DateOnly.FromDateTime(DateTime.Today);
                                bool isPast = item.BookingDate < DateOnly.FromDateTime(DateTime.Today);

                                <tr class="@(isPast ? "table-secondary" : "")">
                                    <td class="px-4 text-muted fw-semibold">@idx</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Customer.FullName</div>
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-phone me-1"></i>@item.Customer.PhoneNumber
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary px-3 py-2">@item.Pitch.Name</span>
                                    </td>
                                    <td>
                                        @item.BookingDate.ToString("dd/MM/yyyy")
                                        @if (isToday)
                                        {
                                            <span class="badge bg-success ms-1">Hôm nay</span>
                                        }
                                        else if (isPast)
                                        {
                                            <span class="badge bg-secondary ms-1">Quá hạn</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-primary">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            @item.TimeSlot.StartTime.ToString("HH:mm") – @item.TimeSlot.EndTime.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">@item.TotalPrice.ToString("#,##0") VNĐ</td>
                                    <td class="small text-muted" style="max-width:150px;">
                                        @(string.IsNullOrEmpty(item.Note) ? "—" : item.Note)
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            @* Xác nhận *@
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="1" />
                                                <input type="hidden" name="returnUrl" value="/Bookings/Confirm" />
                                                <button type="submit" class="btn btn-primary btn-sm px-3"
                                                        onclick="return confirm('Xác nhận đặt sân của khách @item.Customer.FullName?')">
                                                    <i class="bi bi-check-lg me-1"></i> Xác nhận
                                                </button>
                                            </form>
                                            @* Hủy *@
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="3" />
                                                <input type="hidden" name="returnUrl" value="/Bookings/Confirm" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Hủy đặt sân này?')">
                                                    <i class="bi bi-x-lg"></i> Hủy
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Tổng <strong>@Model.Count()</strong> lượt đang chờ xác nhận
                </span>
                <div class="d-flex gap-2">
                    @* Xác nhận tất cả (nếu cần) *@
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-list-check me-1"></i> Xem tất cả đặt sân
                    </a>
                </div>
            </div>
        }
    </div>
</div>

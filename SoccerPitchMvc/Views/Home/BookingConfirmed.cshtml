@model SoccerPitchMvc.Models.Booking

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Đặt sân thành công!";
}

@section Styles {
<style>
    .confirmed-section { min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 60px 0; background: #f8fafc; }
    .confirmed-card { background: #fff; border-radius: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); max-width: 560px; width: 100%; padding: 48px 40px; text-align: center; }
    .success-icon-ring { width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(135deg, #84cc16, #65a30d); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; box-shadow: 0 8px 25px rgba(132,204,22,0.35); }
    .success-icon-ring i { font-size: 42px; color: #fff; }
    .confirmed-title { font-size: 28px; font-weight: 800; color: #0f172a; font-family: 'Outfit', sans-serif; margin-bottom: 8px; }
    .confirmed-sub { color: #64748b; font-size: 15px; margin-bottom: 32px; }
    .booking-id-badge { display: inline-block; background: #f0fdf4; border: 2px solid #84cc16; color: #365314; font-weight: 700; font-size: 14px; border-radius: 50px; padding: 6px 20px; margin-bottom: 28px; }
    .info-grid { background: #f8fafc; border-radius: 16px; padding: 20px 24px; margin-bottom: 28px; text-align: left; }
    .info-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #e2e8f0; }
    .info-row:last-child { border-bottom: none; }
    .info-lbl { font-size: 13px; color: #64748b; font-weight: 500; }
    .info-val { font-size: 14px; font-weight: 700; color: #0f172a; text-align: right; }
    .status-badge { display: inline-flex; align-items: center; gap: 6px; background: #fef9c3; color: #713f12; font-weight: 700; font-size: 13px; padding: 5px 14px; border-radius: 50px; border: 1.5px solid #fde047; }
    .price-highlight { font-size: 22px; font-weight: 800; color: #16a34a; font-family: 'Outfit', sans-serif; }
    .action-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }
    .btn-home { background: #0f172a; color: #fff; font-weight: 700; padding: 12px 28px; border-radius: 12px; text-decoration: none; font-size: 14px; transition: all 0.2s; }
    .btn-home:hover { background: #1e293b; color: #fff; }
    .btn-book-more { background: #84cc16; color: #0f172a; font-weight: 700; padding: 12px 28px; border-radius: 12px; text-decoration: none; font-size: 14px; transition: all 0.2s; }
    .btn-book-more:hover { background: #65a30d; color: #fff; }
    .note-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 14px 18px; text-align: left; margin-top: 20px; }
    .note-box p { font-size: 13px; color: #78350f; margin: 0; }
</style>
}

<div class="confirmed-section">
    <div class="container">
        <div class="confirmed-card mx-auto">

            <!-- Icon -->
            <div class="success-icon-ring">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <h1 class="confirmed-title">Đặt Sân Thành Công!</h1>
            <p class="confirmed-sub">Yêu cầu đặt sân của bạn đã được ghi nhận.<br>Chúng tôi sẽ liên hệ xác nhận sớm nhất.</p>

            <div class="booking-id-badge">
                <i class="fa-solid fa-hashtag me-1"></i> Mã đặt sân: #@Model.Id
            </div>

            <!-- Thông tin booking -->
            <div class="info-grid">
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-user me-1"></i> Khách hàng</span>
                    <span class="info-val">@Model.Customer.FullName</span>
                </div>
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-phone me-1"></i> Điện thoại</span>
                    <span class="info-val">@Model.Customer.PhoneNumber</span>
                </div>
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-table-tennis-paddle-ball me-1"></i> Sân</span>
                    <span class="info-val">@Model.Pitch.Name</span>
                </div>
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-calendar me-1"></i> Ngày chơi</span>
                    <span class="info-val">@Model.BookingDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-clock me-1"></i> Khung giờ</span>
                    <span class="info-val">
                        @Model.TimeSlot.StartTime.ToString("HH:mm") – @Model.TimeSlot.EndTime.ToString("HH:mm")
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="info-row">
                        <span class="info-lbl"><i class="fa-solid fa-note-sticky me-1"></i> Ghi chú</span>
                        <span class="info-val">@Model.Note</span>
                    </div>
                }
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-wallet me-1"></i> Tổng tiền</span>
                    <span class="price-highlight">@Model.TotalPrice.ToString("#,##0") VNĐ</span>
                </div>
                <div class="info-row">
                    <span class="info-lbl"><i class="fa-solid fa-info-circle me-1"></i> Trạng thái</span>
                    <span class="info-val">
                        <span class="status-badge">
                            <i class="fa-solid fa-clock"></i> Chờ xác nhận
                        </span>
                    </span>
                </div>
            </div>

            <div class="action-btns">
                <a href="/Home/Index" class="btn-home">
                    <i class="fa-solid fa-house me-1"></i> Trang chủ
                </a>
                <a href="/Home/Booking" class="btn-book-more">
                    <i class="fa-solid fa-calendar-plus me-1"></i> Đặt thêm sân
                </a>
            </div>

            <div class="note-box mt-4">
                <p><i class="fa-solid fa-lightbulb me-1"></i> <strong>Lưu ý:</strong> Nhân viên sẽ gọi điện xác nhận trong vòng 15 phút. Vui lòng giữ máy. Thanh toán khi đến sân.</p>
            </div>

        </div>
    </div>
</div>

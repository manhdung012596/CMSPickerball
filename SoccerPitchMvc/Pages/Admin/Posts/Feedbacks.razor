@page "/admin/feedbacks"
@layout AdminLayout
@using Microsoft.EntityFrameworkCore
@using SoccerPitchMvc.Data
@using SoccerPitchMvc.Models
@inject ApplicationDbContext DbContext
@inject SoccerPitchMvc.Services.ToastService Toast

<PageTitle>Quản lý Góp ý & Phản hồi - Quản trị</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-comment-dots text-primary me-2"></i> Ý kiến góp ý của khách hàng</h2>
            <p class="text-muted mb-0">Tiếp nhận và quản lý các tin nhắn góp ý, phản hồi gửi từ trang Liên hệ của khách hàng</p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-primary border-3" style="background-color: rgba(13, 110, 253, 0.08);">
                <div class="card-body py-3">
                    <div class="small text-muted fw-semibold text-uppercase">Tổng số ý kiến</div>
                    <div class="fs-2 fw-bold text-primary">@TotalCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-3" style="background-color: rgba(25, 135, 84, 0.08);">
                <div class="card-body py-3">
                    <div class="small text-muted fw-semibold text-uppercase">Chưa xử lý (Mới)</div>
                    <div class="fs-2 fw-bold text-success">@UnreadCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-secondary border-3" style="background-color: rgba(108, 117, 125, 0.08);">
                <div class="card-body py-3">
                    <div class="small text-muted fw-semibold text-uppercase">Đã xử lý / Đã đọc</div>
                    <div class="fs-2 fw-bold text-secondary">@ReadCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm theo Tên, Email hoặc Số điện thoại..."
                               @bind-value="SearchQuery" @bind-value:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="FilterStatus">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="unread">Chưa đọc (Mới)</option>
                        <option value="read">Đã đọc</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                        <i class="fas fa-undo me-1"></i>Reset bộ lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table List -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="50" class="py-3 px-4">#</th>
                            <th width="150" class="py-3">Ngày gửi</th>
                            <th width="200" class="py-3">Khách hàng</th>
                            <th width="150" class="py-3">Liên hệ</th>
                            <th class="py-3">Nội dung góp ý</th>
                            <th width="120" class="text-center py-3">Trạng thái</th>
                            <th width="120" class="text-end py-3 px-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Đang tải...</span>
                                    </div>
                                    <div class="mt-2 text-muted small">Đang tải danh sách góp ý...</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var list = GetFilteredFeedbacks();
                            if (!list.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-envelope-open fa-3x mb-3 text-secondary"></i>
                                        <p class="mb-0">Không tìm thấy góp ý nào phù hợp.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var (item, idx) in list.Select((x, i) => (x, i + 1)))
                                {
                                    <tr class="@(item.Status == 0 ? "fw-semibold table-light" : "")" style="transition: all 0.2s;">
                                        <td class="py-3 px-4 text-muted small">@idx</td>
                                        <td class="py-3 text-muted" style="font-size: 13px;">
                                            @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3">
                                            <div class="text-dark fw-bold">@item.Title</div>
                                            <div class="small text-muted" style="font-size: 12px;">ID: #@item.Id</div>
                                        </td>
                                        <td class="py-3">
                                            <div class="small text-dark"><i class="fa-solid fa-phone me-1 small text-muted"></i>@item.ThumbnailUrl</div>
                                            <div class="small text-muted" style="font-size: 12px;"><i class="fa-solid fa-envelope me-1 small"></i>@item.Summary</div>
                                        </td>
                                        <td class="py-3" style="max-width: 300px; white-space: normal; word-break: break-word; font-size: 14px;">
                                            @item.Content
                                        </td>
                                        <td class="text-center py-3">
                                            @if (item.Status == 0)
                                            {
                                                <span class="badge border px-2 py-1" style="background-color: rgba(25, 135, 84, 0.1); color: #0f5132; border-color: rgba(25, 135, 84, 0.25) !important;">
                                                    <i class="fa-solid fa-circle me-1" style="font-size: 7px;"></i> Mới
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge border px-2 py-1" style="background-color: rgba(108, 117, 125, 0.1); color: #6c757d; border-color: rgba(108, 117, 125, 0.25) !important;">
                                                    Đã đọc
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end py-3 px-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                @if (item.Status == 0)
                                                {
                                                    <button class="btn btn-sm btn-outline-success" title="Đánh dấu đã đọc" @onclick="() => ToggleReadStatus(item)">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" title="Đánh dấu chưa đọc" @onclick="() => ToggleReadStatus(item)">
                                                        <i class="fa-solid fa-envelope"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger" title="Xóa góp ý" @onclick="() => ConfirmDelete(item)">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa -->
@if (ShowDeleteModal && ItemToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Xác nhận xóa</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0">Bạn có chắc chắn muốn xóa thư góp ý của khách hàng <strong>@ItemToDelete.Title</strong>?</p>
                    <small class="text-danger">* Hành động này không thể phục hồi lại sau khi xóa.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Hủy bỏ</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteFeedback">Đồng ý xóa</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Article> FeedbacksList = new();
    private bool IsLoading = true;
    
    private string SearchQuery = "";
    private string FilterStatus = "all";

    private int TotalCount = 0;
    private int UnreadCount = 0;
    private int ReadCount = 0;

    private bool ShowDeleteModal = false;
    private Article? ItemToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedbacks();
    }

    private async Task LoadFeedbacks()
    {
        IsLoading = true;
        try
        {
            FeedbacksList = await DbContext.Articles
                .Where(a => a.AuthorName == "Customer Feedback")
                .OrderByDescending(a => a.CreatedAt)
                .ToListAsync();

            TotalCount = FeedbacksList.Count;
            UnreadCount = FeedbacksList.Count(a => a.Status == 0);
            ReadCount = FeedbacksList.Count(a => a.Status == 1);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi tải danh sách góp ý: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<Article> GetFilteredFeedbacks()
    {
        var query = FeedbacksList.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            query = query.Where(f => 
                f.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                (f.Summary != null && f.Summary.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (f.ThumbnailUrl != null && f.ThumbnailUrl.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
            );
        }

        if (FilterStatus == "unread")
        {
            query = query.Where(f => f.Status == 0);
        }
        else if (FilterStatus == "read")
        {
            query = query.Where(f => f.Status == 1);
        }

        return query.ToList();
    }

    private void ResetFilters()
    {
        SearchQuery = "";
        FilterStatus = "all";
    }

    private async Task ToggleReadStatus(Article item)
    {
        try
        {
            item.Status = item.Status == 0 ? 1 : 0;
            DbContext.Articles.Update(item);
            await DbContext.SaveChangesAsync();

            Toast.ShowSuccess($"Đã đổi trạng thái xử lý thành công.");
            await LoadFeedbacks();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi cập nhật trạng thái: {ex.Message}");
        }
    }

    private void ConfirmDelete(Article item)
    {
        ItemToDelete = item;
        ShowDeleteModal = true;
    }

    private void CancelDelete()
    {
        ItemToDelete = null;
        ShowDeleteModal = false;
    }

    private async Task DeleteFeedback()
    {
        if (ItemToDelete == null) return;
        try
        {
            DbContext.Articles.Remove(ItemToDelete);
            await DbContext.SaveChangesAsync();
            Toast.ShowSuccess("Đã xóa thư ý kiến đóng góp thành công.");
            await LoadFeedbacks();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Lỗi khi xóa ý kiến đóng góp: {ex.Message}");
        }
        finally
        {
            CancelDelete();
        }
    }
}
